# N3D catalog — example environment.
# Copy to .env (Dockge: paste into the stack's .env box; Portainer: add these as
# stack environment variables) and fill in your own values. Never commit the real .env.
# Blank = off/default unless a comment says otherwise.

# ---------- Required ----------

# Password for /admin. Blank = every admin login is rejected.
ADMIN_PASSWORD=

# Signs admin login cookies. Long random string: openssl rand -hex 32
# Blank = a random one each start, so a restart logs you out.
SESSION_SECRET=

# "true" only once /admin is reached solely over HTTPS (Pangolin, NPM, Cloudflare Tunnel...).
# "true" over plain http://<host>:8090 breaks admin login.
COOKIE_SECURE=false

# ---------- N3D ----------

# Your N3D API key, for "Sync from N3D". Can be left blank and pasted into
# admin → Settings instead (saved there, it overrides this).
N3D_API_KEY=

# ---------- Square ----------

# Square access token (scopes: ITEMS_READ, ITEMS_WRITE, MERCHANT_PROFILE_READ,
# plus ORDERS_READ for the sales webhook). Can be pasted into admin → Square instead.
SQUARE_ACCESS_TOKEN=
# "sandbox" or "production". Try sandbox with a sandbox token first. Env-only.
SQUARE_ENV=production

# ---------- Email (quote PDFs to the customer and to you) ----------
# Optional: can also be set in admin → Settings → Email, which overrides these.
# Without it, quotes are still saved and downloadable, just not emailed.

SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (port 465), "false" for STARTTLS (587). Blank = guess from the port.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender, e.g. "Voxelwaves" <hello@example.com>
SMTP_FROM=

# ---------- Spoolman (optional) ----------

# Base URL of your Spoolman, no trailing slash, e.g. http://192.168.1.20:7912
SPOOLMAN_URL=

# ---------- Stockroom link (optional; see README → Stockroom link) ----------

# How THIS container reaches Stockroom on the LAN, e.g. http://192.168.1.20:8085.
# Server-to-server: not through Pangolin.
STOCKROOM_URL=
# Shared secret, the same value in BOTH stacks: openssl rand -hex 32
INTEGRATION_KEY=

# Square sales coming off Stockroom's counts. Subscribe the Square app's webhook
# to payment.created and payment.updated at the URL below (your PUBLIC catalog
# address), and paste the signature key Square shows. Signature key blank = webhook off.
# e.g. https://catalog.example.com/api/v1/webhooks/square (must match Square exactly)
SQUARE_WEBHOOK_URL=
SQUARE_WEBHOOK_SIGNATURE_KEY=
